# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive variables
*.tfvars
!terraform.tfvars.example

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files for tests
!test/*_override.tf
!test/*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
